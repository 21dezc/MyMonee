generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  budgets       Budget[]
  recurring     RecurringTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}


model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  createdAt    DateTime        @default(now())
  transactions Transaction[]
  budgets Budget[]
  recurring RecurringTransaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([recurringId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Budget {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  userId     String
  categoryId String

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id          String              @id @default(cuid())
  amount      Decimal             @db.Decimal(12, 2)
  type        TransactionType
  description String?
  frequency   RecurrenceFrequency @default(MONTHLY)

  // วันเริ่ม ใช้เป็นหลักยึดวันที่/วันในสัปดาห์ของทุกงวด
  // (เก็บเป็น 00:00 UTC ของวันที่ตามเวลาไทย เหมือน date ของ Transaction ที่ระบบสร้าง)
  startDate   DateTime

  // วันที่ครั้งถัดไปที่ระบบจะสร้างรายการ / วันที่สร้างล่าสุด
  nextRunDate DateTime
  lastRunDate DateTime?

  // เงื่อนไขสิ้นสุด (ใส่ได้อย่างใดอย่างหนึ่ง หรือไม่ใส่เลย = ไม่มีกำหนด)
  endDate      DateTime?
  installments Int?

  // จำนวนครั้งที่สร้างไปแล้ว
  runCount    Int                 @default(0)

  // active = เปิดใช้งาน, finished = ครบกำหนด/ครบงวดแล้ว (เปิดใหม่ไม่ได้)
  active      Boolean             @default(true)
  finished    Boolean             @default(false)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  userId      String
  categoryId  String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([active, finished, nextRunDate])
}
